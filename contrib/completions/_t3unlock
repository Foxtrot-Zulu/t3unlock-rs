}
(( $+functions[_t3unlock__gen-man_commands] )) ||
_t3unlock__gen-man_commands() {
    local commands; commands=()
    _describe -t commands 't3unlock gen-man commands' commands "$@"
}
(( $+functions[_t3unlock__help_commands] )) ||
_t3unlock__help_commands() {
    local commands; commands=(
'status:Show device presence and lock status' \
'unlock:Unlock the drive (prompts for password if not provided)' \
'doctor:Diagnose common Linux permission/udev issues' \
'gen-completions:Generate shell completions' \
'gen-man:Generate a man page to the given directory' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 't3unlock help commands' commands "$@"
}
(( $+functions[_t3unlock__help__doctor_commands] )) ||
_t3unlock__help__doctor_commands() {
    local commands; commands=()
    _describe -t commands 't3unlock help doctor commands' commands "$@"
}
(( $+functions[_t3unlock__help__gen-completions_commands] )) ||
_t3unlock__help__gen-completions_commands() {
    local commands; commands=()
    _describe -t commands 't3unlock help gen-completions commands' commands "$@"
}
(( $+functions[_t3unlock__help__gen-man_commands] )) ||
_t3unlock__help__gen-man_commands() {
    local commands; commands=()
    _describe -t commands 't3unlock help gen-man commands' commands "$@"
}
(( $+functions[_t3unlock__help__help_commands] )) ||
_t3unlock__help__help_commands() {
    local commands; commands=()
    _describe -t commands 't3unlock help help commands' commands "$@"
}
(( $+functions[_t3unlock__help__status_commands] )) ||
_t3unlock__help__status_commands() {
    local commands; commands=()
    _describe -t commands 't3unlock help status commands' commands "$@"
}
(( $+functions[_t3unlock__help__unlock_commands] )) ||
_t3unlock__help__unlock_commands() {
    local commands; commands=()
    _describe -t commands 't3unlock help unlock commands' commands "$@"
}
(( $+functions[_t3unlock__status_commands] )) ||
_t3unlock__status_commands() {
    local commands; commands=()
    _describe -t commands 't3unlock status commands' commands "$@"
}
(( $+functions[_t3unlock__unlock_commands] )) ||
_t3unlock__unlock_commands() {
    local commands; commands=()
    _describe -t commands 't3unlock unlock commands' commands "$@"
}

if [ "$funcstack[1]" = "_t3unlock" ]; then
    _t3unlock "$@"
else
    compdef _t3unlock t3unlock
fi
