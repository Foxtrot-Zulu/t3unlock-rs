#compdef t3unlock

autoload -U is-at-least

_t3unlock() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_t3unlock_commands" \
"*::: :->t3unlock" \
&& ret=0
    case $state in
    (t3unlock)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:t3unlock-command-$line[1]:"
        case $line[1] in
            (status)
_arguments "${_arguments_options[@]}" : \
'--vid=[USB Vendor ID (hex, e.g. 0x04e8 for Samsung). If omitted, defaults are used]:VID:_default' \
'--pid=[USB Product ID (hex). If omitted, defaults are used]:PID:_default' \
'--json[Output JSON]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(unlock)
_arguments "${_arguments_options[@]}" : \
'--vid=[USB Vendor ID (hex)]:VID:_default' \
'--pid=[USB Product ID (hex)]:PID:_default' \
'--password=[Password (unsafe on shared shells; prefer interactive prompt)]:PASSWORD:_default' \
'--timeout-ms=[USB transfer timeout in milliseconds (default 5000)]:TIMEOUT_MS:_default' \
'--dry-run[Simulate the unlock sequence without touching USB]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(doctor)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(gen-completions)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
':shell:(bash zsh fish)' \
&& ret=0
;;
(gen-man)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
':out -- Output directory for man page (e.g., ./target):_files' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_t3unlock__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:t3unlock-help-command-$line[1]:"
        case $line[1] in
            (status)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(unlock)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(doctor)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(gen-completions)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(gen-man)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
}

(( $+functions[_t3unlock_commands] )) ||
_t3unlock_commands() {
    local commands; commands=(
'status:Show device presence and lock status' \
'unlock:Unlock the drive (prompts for password if not provided)' \
'doctor:Diagnose common Linux permission/udev issues' \
'gen-completions:Generate shell completions' \
'gen-man:Generate a man page to the given directory' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 't3unlock commands' commands "$@"
}
(( $+functions[_t3unlock__doctor_commands] )) ||
_t3unlock__doctor_commands() {
    local commands; commands=()
    _describe -t commands 't3unlock doctor commands' commands "$@"
}
(( $+functions[_t3unlock__gen-completions_commands] )) ||
_t3unlock__gen-completions_commands() {
    local commands; commands=()
